{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and cryptographic clearance settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the operator"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name or operator moniker"
        },
        "username": {
          "type": "string",
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique username handle"
        },
        "callsign": {
          "type": "string",
          "maxLength": 50,
          "description": "Tactical callsign identifier"
        },
        "clearanceLevel": {
          "type": "string",
          "enum": ["CONFIDENTIAL", "SECRET", "TOP_SECRET"],
          "description": "Cryptographic security clearance level"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp ISO string"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp ISO string"
        }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "VaultMessage": {
      "title": "VaultMessage",
      "description": "Encrypted message record stored in the user vault (Zero Plaintext stored)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message document identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "ciphertext": {
          "type": "string",
          "maxLength": 20000,
          "description": "Encrypted ciphertext payload"
        },
        "shift": {
          "type": "number",
          "description": "Caesar cipher key shift (0-25)"
        },
        "operationType": {
          "type": "string",
          "enum": ["ENCRYPT", "DECRYPT"],
          "description": "Original cipher operation type"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Mission notes or message description"
        },
        "characterCount": {
          "type": "number",
          "description": "Length of the ciphertext string"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of vault storage"
        }
      },
      "required": ["userId", "ciphertext", "shift", "operationType", "createdAt"]
    },
    "ActivityRecord": {
      "title": "ActivityRecord",
      "description": "Audit log item of cipher actions and key transitions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Activity record document ID"
        },
        "userId": {
          "type": "string",
          "description": "Operator user ID"
        },
        "type": {
          "type": "string",
          "enum": ["ENCRYPT", "DECRYPT", "BRUTE_FORCE", "KEY_CHANGE", "LOGIN", "CLEAR"],
          "description": "Action category"
        },
        "details": {
          "type": "string",
          "maxLength": 500,
          "description": "Human-readable summary of operation"
        },
        "shift": {
          "type": "number",
          "description": "Shift value involved"
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp string of execution"
        }
      },
      "required": ["userId", "type", "timestamp"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Connection health test document",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Connection status string"
        }
      }
    }
  },
  "firestore": {
    "/test/{docId}": {
      "schema": {
        "$ref": "#/entities/ConnectionTest"
      },
      "description": "Firestore connectivity test health check endpoint"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user account profile and clearance settings"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/VaultMessage"
      },
      "description": "Individual operator encrypted message vault collection"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": {
        "$ref": "#/entities/ActivityRecord"
      },
      "description": "Private operational telemetry and activity logs"
    }
  }
}
